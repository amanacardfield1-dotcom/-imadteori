PORT=4000
JWT_SECRET=change-this-to-a-long-random-secret

# حساب صاحب المنصة (عماد) — يُنشأ تلقائيًا عند تشغيل الخادم لأول مرة.
# غيّر القيم هنا فقط إن أردت بيانات مختلفة قبل أول تشغيل.
ADMIN_EMAIL=Mallaemad@gmail.com
ADMIN_PASSWORD=change-me

# بيانات مشروع Firebase (Firestore) — من ملف مفتاح حساب الخدمة (service account key)
# الذي تنزّله من: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
